<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    tools:context=".PaymentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Métodos de Pagamento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp" />

        <!-- Valor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valor (Ex: 10.00)"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <!-- ID Automação -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID Automação (Token / External ID)"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <EditText
            android:id="@+id/etExternalId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deixe em branco para gerar automático"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Checkboxes -->
        <CheckBox
            android:id="@+id/cbAutoConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Com confirmação automática"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbAutoPrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Com impressão automática"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbMerchantReceipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Imprimir recibo do lojista"
            android:layout_marginBottom="16dp" />

        <!-- Tipo de Pagamento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de Pagamento"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgPaymentType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbDebit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Débito" />

            <RadioButton
                android:id="@+id/rbCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crédito" />

            <RadioButton
                android:id="@+id/rbPix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PIX" />

            <RadioButton
                android:id="@+id/rbVoucher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voucher" />
        </RadioGroup>

        <!-- Parcelas e Prazos -->
        <LinearLayout
            android:id="@+id/layoutInstallmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Número de Parcelas (Crédito Parcelado)"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />

            <EditText
                android:id="@+id/etInstallments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1"
                android:inputType="number"
                android:text="1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prazo (Dias pós-crédito)"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />

            <EditText
                android:id="@+id/etPostCreditDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number"
                android:text="0"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <!-- Botão Iniciar Pagamento -->
        <Button
            android:id="@+id/btnStartPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Pagamento"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Resultado -->
        <LinearLayout
            android:id="@+id/layoutPaymentResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#DDDDDD"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resultado da Transação:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvPaymentResultStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvPaymentResultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
